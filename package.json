{
  "name": "mockforge",
  "version": "1.0.0",
  "private": true,
  "description": "Hosted fake-data API for REST, GraphQL, WebSockets, and Socket.IO.",
  "homepage": "https://mockforge.dev",
  "bugs": {
    "url": "https://github.com/deepakkumardewani/mockforge/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepakkumardewani/mockforge.git"
  },
  "engines": {
    "node": ">=20",
    "bun": ">=1.3.6"
  },
  "packageManager": "bun@1.3.6",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "clean:web": "turbo run clean --filter=@mockforge/web",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "lint": "turbo run lint",
    "format": "turbo run format",
    "typecheck": "turbo run typecheck",
    "verify": "turbo run lint format typecheck",
    "ci": "turbo run lint typecheck test"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "@playwright/test": "^1.49.0"
  }
}
