# ── Redis ──────────────────────────────────────────────────────────────────────
# Development: use a local Redis instance (Docker or Homebrew)
REDIS_LOCAL=true
REDIS_URL=redis://localhost:6379

# Production (Upstash): set these and remove REDIS_LOCAL / REDIS_URL
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token-here

# ── API ────────────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# Web (docs, playground, builder). Local defaults match the API / Socket.IO ports.
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SOCKETIO_URL=http://localhost:4001

# ── Cronitor (optional) ────────────────────────────────────────────────────────
CRONITOR_API_KEY=your-cronitor-api-key
